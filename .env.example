# Copy to .env for local runs. On Unraid these are set as container variables.

PORT=8080
DATA_DIR=./var
TZ=America/Chicago

# Who may create an account. The first account is always the admin.
OPEN_SIGNUP=true
INVITE_REQUIRED=false

# ---------------------------------------------------------------------------
# Optional: self-hosted LLM as a second-opinion grader for freeform answers.
#
# The app is fully functional without this. When set, the model is consulted
# ONLY for sentence-length answers the rule-based grader marked wrong, and it
# can only upgrade a verdict — never make grading harsher. If the endpoint is
# slow or down, the rules simply stand.
#
# Any OpenAI-compatible server works. The URL must include /v1.
#   Ollama            http://HOST:11434/v1        model: qwen2.5:7b-instruct
#   LM Studio         http://HOST:1234/v1         model: (as shown in the UI)
#   vLLM              http://HOST:8000/v1         model: (the served name)
#   LocalAI           http://HOST:8080/v1
#   llama.cpp server  http://HOST:8080/v1
# ---------------------------------------------------------------------------
# AI_BASE_URL=http://192.168.1.50:11434/v1
# AI_MODEL=qwen2.5:7b-instruct
# AI_API_KEY=
# AI_TIMEOUT_MS=9000
